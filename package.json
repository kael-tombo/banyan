{
  "name": "banyan-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Banyan.ai — The Agentic Operating System for Product Distribution",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/migrate-if-configured.ts && next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "npm run db:deploy && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "lucide-react": "^0.525.0",
    "next": "^15.5.0",
    "prisma": "^6.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true
  }
}
