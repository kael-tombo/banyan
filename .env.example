# Copy to .env and fill in. Everything works without optional keys;
# features that need them stay clearly marked as "not configured".

# --- Required ---
# PostgreSQL connection URL (e.g. hosted Prisma Postgres).
# DATABASE_URL is canonical; if your platform injects the same value under
# PRISMA_DATABASE_URL or POSTGRES_URL instead, those are accepted as-is
# (precedence: DATABASE_URL > PRISMA_DATABASE_URL > POSTGRES_URL).
DATABASE_URL=postgres://user:password@host:5432/postgres?sslmode=require
APP_SECRET=""                # 32-byte hex, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI content generation (optional) ---
# Any OpenAI-compatible endpoint. Without it, generation uses a clearly
# labeled local template fallback (never presented as live model output).
AI_PROVIDER=""               # "openai" | "opencode" | "" (auto)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Optional extra HTTP headers (JSON object) merged into every model request —
# for gateways that require routing/auth headers beyond the bearer token.
# Example: {"X-Z-AI-From":"Z","X-Token":"…"}
OPENAI_EXTRA_HEADERS=""

# Transactional email (US-010): verification, password reset, approval notices.
# Any SMTP vendor works, e.g. smtps://resend:API_KEY@smtp.resend.com:465
# Empty: emails are written to the server log as "not sent (dev transport)",
# and email verification is not required (nobody could receive the link).
SMTP_URL=""
EMAIL_FROM="Banyan <no-reply@localhost>"

# --- Experimental brain: local OpenCode (development only) ---
# With no OPENAI_API_KEY, Banyan can borrow a local `opencode serve` as its
# model: run `npm run brain:opencode` and paste the lines it prints. Ignored in
# production and whenever OPENAI_API_KEY is set. If OpenCode does not answer
# within the timeout (expired key, free quota used up), generation drops back
# to the labeled template fallback.
OPENCODE_URL=""              # e.g. http://127.0.0.1:4097
OPENCODE_PASSWORD=""
OPENCODE_MODEL="opencode/deepseek-v4.1-flash-free"   # any `opencode models` id
OPENCODE_TIMEOUT_MS="90000"

# --- Publishing worker (optional) ---
WORKER_SECRET=""
WORKER_INTERVAL_MS="60000"   # maintenance sweep interval (queue mode) or tick interval (fallback)

# --- Sign-in providers / SSO (optional) ---
# Each provider appears on the sign-in page only when both values are set.
# Redirect URI to register with each provider:
#   ${NEXT_PUBLIC_APP_URL}/api/auth/oauth/<provider>/callback
# where <provider> is google, microsoft, github, linkedin, facebook or x.
# Setup steps per provider: docs/SSO.md
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_MICROSOFT_CLIENT_ID=""
OAUTH_MICROSOFT_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_LINKEDIN_CLIENT_ID=""
OAUTH_LINKEDIN_CLIENT_SECRET=""
OAUTH_FACEBOOK_CLIENT_ID=""
OAUTH_FACEBOOK_CLIENT_SECRET=""
OAUTH_X_CLIENT_ID=""
OAUTH_X_CLIENT_SECRET=""

# --- Docker Compose stack (docker compose up -d --build) ---
# Compose builds DATABASE_URL and REDIS_URL itself from these; the values above
# are for running outside Docker (npm run dev).
POSTGRES_USER="banyan"
POSTGRES_PASSWORD=""          # required by Compose; any strong random string
POSTGRES_DB="banyan"
WEB_PORT="3000"               # host port for the web service
# COMPOSE_APP_URL=""          # public URL if not http://localhost:$WEB_PORT
WORKER_CONCURRENCY="4"        # jobs processed in parallel per worker

# --- Job queue (optional outside Docker) ---
# With REDIS_URL the worker consumes the BullMQ queue; without it the worker
# falls back to POSTing /api/worker/tick every WORKER_INTERVAL_MS.
# REDIS_URL="redis://localhost:6379/0"

# --- Seed ---
SEED_USER_EMAIL="founder@banyan.ai"
SEED_USER_PASSWORD="banyan-demopass"

# --- Agentic runtime (optional) ---
# Per-workspace daily cap on live model actions. Single-shot calls and agentic
# runs share this quota; one run consumes one unit (ADR-007).
MODEL_MAX_CALLS_PER_DAY="500"
# Agent runtime (ADR-006/007): "direct" = one model call per task (default,
# always available). "opencode" = the embedded OpenCode host with tools and
# subagents; not built until roadmap R2 — until then the selection falls back
# to "direct" with a labelled reason, never silently.
AGENT_RUNTIME="direct"
# Model tiers for the opencode runtime, each "provider/model" (validated at
# startup; empty FAST/CRITIC fall back to STRONG). STRONG is required when
# AGENT_RUNTIME=opencode. In production, CRITIC must be from another model family
# than FAST and STRONG, and OpenCode's hosted inference is refused.
# Dev example (OpenCode Go, internal use only): opencode-go/glm-5.3-flash
AGENT_MODEL_STRONG=""
AGENT_MODEL_FAST=""
AGENT_MODEL_CRITIC=""
FASTLANE_API_KEY=""            # optional: enables the Fastlane capability adapter (unverified until exercised)

# --- Publishing through SocialFlow (optional) ---
# A SocialFlow API speaking docs/SOCIALFLOW_INTEGRATION_AUDIT.md's contract,
# e.g. SocialFlow Lite (kael-tombo/socialFlow, branch socialflow-lite). The provider
# stays disabled until SOCIALFLOW_VERIFIED=true, which you set only after
# `npm run smoke:socialflow -- --publish` passes against real accounts.
# SOCIALFLOW_API_URL="https://social.example.com"
# SOCIALFLOW_VERIFIED="false"
# Set to "true" only when SOCIALFLOW_API_URL is on a private network you run
# (e.g. http://socialflow:8080 on the Compose network). Default keeps the SSRF guard.
# SOCIALFLOW_ALLOW_PRIVATE_NETWORK="false"
# "mcp" carries the same contract as MCP tool calls to ${SOCIALFLOW_API_URL}/mcp
# (SocialFlow Lite serves both); "rest" or unset uses the REST endpoints.
# SOCIALFLOW_TRANSPORT="rest"
# Used by the smoke test only (in the app, the key lives on the connection):
# SOCIALFLOW_API_KEY=""

# --- Deploy-time ---
# Set to 0 to skip prisma migrate deploy during `npm run build` and run
# migrations out-of-band instead. Default: deploy when a real DB URL is set.
# MIGRATE_ON_BUILD=0
