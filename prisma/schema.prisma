// Banyan.ai data model — PostgreSQL (hosted, e.g. Prisma Postgres) via Prisma.
// Enums are represented as validated strings (portable across providers);
// validation lives in src/lib/state-machines.ts and zod schemas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  name                  String
  // Null for accounts created through a sign-in provider and never given a password.
  passwordHash          String?
  createdAt             DateTime      @default(now())
  onboardingCompletedAt DateTime?
  // Attribution recorded at signup when a tracked visitor cookie exists (observed, not inferred).
  attributedLinkId      String?
  attributedCampaignId  String?
  attributedSource      String?
  sessions              Session[]
  oauthAccounts         OAuthAccount[]
  memberships           Membership[]
  approvals             ContentItem[] @relation("approvals")
  planApprovals         GoalPlan[]    @relation("planApprovals")
}

/// A sign-in provider identity linked to a user (Google, GitHub, ...). Only
/// the identity is kept: provider access tokens are used once and discarded.
model OAuthAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  email             String?
  emailVerified     Boolean   @default(false)
  displayName       String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // The seeded Banyan.ai self-distribution workspace is its own first customer.
  isSelf    Boolean  @default(false)
  // Agent activity control: when set, the orchestrator reconciles but never
  // executes new task work for this workspace (pause is human-controlled).
  agentsPausedAt DateTime?
  // Business basics captured in onboarding (US-019). timeZone is an IANA name
  // used to display and enter schedule times; storage stays UTC.
  businessName  String  @default("")
  industry      String  @default("")
  businessModel String  @default("")
  timeZone      String  @default("UTC")
  createdAt DateTime @default(now())

  memberships     Membership[]
  profile         ProductProfile?
  insights        AudienceInsight[]
  campaigns       Campaign[]
  contentItems    ContentItem[]
  connections     ChannelConnection[]
  trackedLinks    TrackedLink[]
  metrics         CampaignMetric[]
  events          MetricEvent[]
  experiments     Experiment[]
  activity        ActivityEvent[]
  goals           Goal[]
  agentTasks      AgentTask[]
  profileFacts    ProfileFact[]
  strategies      Strategy[]
  recommendations Recommendation[]
  modelCalls      ModelCall[]
  chatMessages    ChatMessage[]
  onboardingStages OnboardingStage[]
  productAnalyses  ProductAnalysis[]
}

/// Onboarding progress, one row per stage the workspace has finished or
/// skipped (US-018). Stages with no row are not started. The stage list and
/// which stages are required live in src/lib/onboarding/stages.ts.
model OnboardingStage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stage       String
  // done | skipped
  status      String
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, stage])
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model ProductProfile {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name            String
  description     String
  website         String?
  stage           String // idea | building | launched | growing
  problem         String
  valueProp       String
  // Audience
  audience        String?
  audiencePain    String?
  audienceOutcome String?
  market          String?
  // Distribution goal
  goal            String? // first_users | launch | audience | leads | activation | conversions
  goalTarget      Int?
  goalMetric      String?
  positioning     String?
  // JSON: array of channel keys
  channels        String   @default("[]")
  // JSON: { tone, language, themes, avoid, cta, approvalPreference }
  brandVoice      String   @default("{}")
  timezone        String   @default("UTC")
  // Structured profile from the website analysis (US-022/US-023), JSON arrays of strings
  features           String    @default("[]")
  problemsSolved     String    @default("[]")
  differentiators    String    @default("[]")
  missingInformation String    @default("[]")
  // JSON: field -> "user" | "analysis" — the founder's own words always win
  fieldSources       String    @default("{}")
  lastAnalysisId     String?
  // Approval (US-023). A profile with analysis-sourced fields must be approved
  // before strategy work; editing an approved profile starts a new version.
  approvedAt         DateTime?
  approvedById       String?
  version            Int       @default(1)
  updatedAt       DateTime @updatedAt
}

model AudienceInsight {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  body        String
  // assumption | interview | research | observed
  source      String    @default("assumption")
  confidence  String    @default("low") // low | medium | high
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model Campaign {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  objective      String
  targetAudience String
  keyMessage     String
  evidence       String    @default("")
  cta            String
  // JSON arrays
  channels       String    @default("[]")
  formats        String    @default("[]")
  // JSON: { startDate?, cadence?, notes? }
  schedule       String    @default("{}")
  successMetric  String
  // draft | planned | in_progress | completed | archived
  status         String    @default("draft")
  startedAt      DateTime?
  completedAt    DateTime?
  isSelfCampaign Boolean   @default(false)
  selfTheme      String?
  // The goal this campaign serves (agentic execution); null for standalone campaigns
  goalId         String?
  goal           Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items       ContentItem[]
  metrics     CampaignMetric[]
  experiments Experiment[]
  links       TrackedLink[]
  tasks       AgentTask[]

  @@index([workspaceId, status])
  @@index([goalId])
}

model ContentItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  channel         String // x | linkedin | shortvideo
  format          String
  title           String
  body            String
  // draft | ready_for_review | approved | scheduled | publishing | published | failed | rejected | archived
  status          String    @default("draft")
  scheduledFor    DateTime?
  approvedById    String?
  approvedBy      User?     @relation("approvals", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  // JSON: { provider, model, isFallback, note, promptTokens?, completionTokens? }
  generationMeta  String    @default("{}")
  // JSON: { hook, scenes: [...], onScreenText, caption, cta } for short-form video
  videoExtras     String    @default("{}")
  sourceRef       String?
  // US-044: the approved strategy and messaging angle this draft serves, and
  // pre-review flags (banned terms, over-limit) as JSON [{code, message, ...}]
  strategyId      String?
  angle           String?
  checks          String    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions    ContentRevision[]
  publications Publication[]

  @@index([workspaceId, status])
  @@index([campaignId])
  @@index([workspaceId, strategyId])
}

model ContentRevision {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  title         String
  body          String
  note          String      @default("")
  authorType    String      @default("user") // ai | user
  meta          String      @default("{}")
  createdAt     DateTime    @default(now())

  @@index([contentItemId])
}

model ChannelConnection {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The channel this connection publishes to: x | linkedin | shortvideo
  channel         String
  // Distribution provider id from src/lib/distribution/providers.ts (socialflow).
  // Rows with "postiz" are historical: Postiz was removed (ADR-003) and they are status=removed.
  adapter         String    @default("socialflow")
  label           String
  // AES-256-GCM encrypted JSON of provider-specific credentials
  configEncrypted String
  // configured | verified | error | removed (kept for audit, never used to publish)
  status          String    @default("configured")
  lastCheckedAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())

  publications Publication[]

  @@index([workspaceId])
}

model Publication {
  id               String             @id @default(cuid())
  contentItemId    String
  contentItem      ContentItem        @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  connectionId     String?
  connection       ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  provider         String
  // scheduled | attempting | published | failed | blocked
  status           String             @default("scheduled")
  externalId       String?
  externalUrl      String?
  // Raw provider response (audit trail)
  providerResponse String             @default("{}")
  attempts         Int                @default(0)
  lastError        String?
  scheduledFor     DateTime?
  publishedAt      DateTime?
  idempotencyKey   String             @unique
  manual           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([contentItemId])
  @@index([status, scheduledFor])
}

model TrackedLink {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentItemId String?
  slug          String    @unique
  targetUrl     String
  utm           String    @default("{}")
  clicks        Int       @default(0)
  createdAt     DateTime  @default(now())
  lastClickAt   DateTime?

  events MetricEvent[]

  @@index([workspaceId])
  @@index([campaignId])
}

model CampaignMetric {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // provider | manual
  source      String
  metric      String // e.g. impressions, engagements, link_clicks, signups
  value       Float
  recordedAt  DateTime  @default(now())
  note        String?

  @@index([workspaceId, campaignId])
}

// First-party funnel events: visit | signup | onboarding_complete
model MetricEvent {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        String
  campaignId  String?
  linkId      String?
  link        TrackedLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  visitorId   String?
  userId      String?
  meta        String       @default("{}")
  createdAt   DateTime     @default(now())

  @@index([workspaceId, type, createdAt])
}

model Experiment {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  title           String
  hypothesis      String
  audience        String?
  channel         String?
  variable        String
  successMetric   String
  // planned | running | complete | abandoned
  status          String    @default("planned")
  results         String?
  interpretation  String?
  limitations     String?
  nextAction      String?
  // JSON snapshot of actual observed numbers taken when conclusions were drafted
  metricsSnapshot String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  decidedAt       DateTime?

  @@index([workspaceId])
}

model ActivityEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // publication_attempt | publication_success | publication_failed | approval | content_created | signup | visit | experiment_update | connection | campaign | metric
  type         String
  // user | system | ai
  actorType    String    @default("user")
  actorSummary String?
  summary      String
  meta         String    @default("{}")
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Agentic execution runtime
// ---------------------------------------------------------------------------

// A persistent, measurable objective. The execution envelope for the agent
// runtime: every plan, task, campaign and recommendation can trace back here.
model Goal {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  objective     String
  description   String    @default("")
  successMetric String
  metricTarget  Float?
  metricUnit    String?
  deadline      DateTime?
  constraints   String    @default("")
  // draft | planning | awaiting_approval | active | paused | achieved | missed | cancelled
  status        String    @default("draft")
  // 0..100, recomputed by the orchestrator from task completion (cached)
  progress      Float     @default(0)
  // user | ai_suggested
  source        String    @default("user")
  // The original natural-language instruction the goal was created from
  rawInput      String    @default("")
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan            GoalPlan?
  tasks           AgentTask[]
  campaigns       Campaign[]
  recommendations Recommendation[]

  @@index([workspaceId, status])
}

// The structured plan Banyan drafts for a goal. Requires explicit human
// approval before any consequential task is created or executed.
model GoalPlan {
  id             String    @id @default(cuid())
  goalId         String    @unique
  goal           Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  summary        String
  // JSON string arrays: assumptions[], missingInfo[], risks[], phases[{name, description, taskTypes[]}]
  assumptions    String    @default("[]")
  missingInfo    String    @default("[]")
  risks          String    @default("[]")
  phases         String    @default("[]")
  // planned | approved | rejected | superseded
  status         String    @default("planned")
  approvedById   String?
  approvedBy     User?     @relation("planApprovals", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?
  // JSON: { provider, model, isFallback, label }
  generatedMeta  String    @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// One unit of agent work. Immutable record of what was asked, who ran it,
// what happened, and what was verified — the execution audit trail.
model AgentTask {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId           String?
  goal             Goal?     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  // Stable per-workflow slot key (e.g. "goal:xyz:content:x"). Unique to make
  // task creation idempotent across ticks, retries and crash resumptions.
  dedupeKey        String    @unique
  // plan_draft | research | strategy | campaign_plan | content_draft | approval_gate | publish | measure | evaluate | recommend
  type             String
  title            String
  // planner | researcher | strategist | creator | publisher | analyst
  agentRole        String
  // pending | ready | running | waiting_approval | blocked | completed | failed | cancelled
  status           String    @default("pending")
  // JSON: structured inputs
  inputs           String    @default("{}")
  // JSON: expected output description / result envelope
  expectedOutput   String    @default("{}")
  // JSON result written on completion (also read on resumption for idempotent adoption)
  output           String?
  // JSON: verification criteria { kind: "nonempty"|"json_schema"|"provider_confirmed", schema?: string }
  verification     String    @default("{}")
  requiresApproval Boolean   @default(false)
  // JSON array of task ids this task depends on
  dependsOn        String    @default("[]")
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3)
  lastError        String?
  // Crash-recovery lease: a running task whose lease expired is requeued
  leasedUntil      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  runs TaskRun[]

  @@index([workspaceId, status])
  @@index([goalId])
}

// Execution record for one attempt of an agent task.
model TaskRun {
  id         String    @id @default(cuid())
  taskId     String
  task       AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt    Int       @default(1)
  // running | completed | failed | requeued
  status     String    @default("running")
  output     String?
  error      String?
  // JSON array of step log entries [{ at, step, detail }]
  log        String    @default("[]")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([taskId])
}

// Persistent business context with explicit provenance. Verified facts,
// user-provided information, external observations and generated hypotheses
// are always distinguishable, and every value can be inspected and corrected.
model ProfileFact {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // product | audience | positioning | voice | competitor | constraint | resource | metric | research
  category    String
  // Stable slug within the category, e.g. "value_prop", "competitor:acme"
  key         String
  value       String
  // verified | user_provided | external_observation | hypothesis
  provenance  String    @default("user_provided")
  // Where this value came from, human readable: "onboarding", "user correction", "task:<id>"
  source      String?
  confidence  String    @default("medium") // low | medium | high
  verifiedAt  DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, category, key])
  @@index([workspaceId])
}

// An evidence-backed next action. Recommendations must cite recorded evidence
// and disclose uncertainty; empty evidence forces low confidence.
model Recommendation {
  id           String    @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  campaignId   String?
  experimentId String?
  title        String
  rationale    String
  // JSON array [{ source, ref, summary }] — each entry cites recorded data
  evidence     String    @default("[]")
  // low | medium | high
  confidence   String    @default("low")
  uncertainty  String    @default("")
  // open | accepted | dismissed | acted_upon
  status       String    @default("open")
  producedBy   String    @default("agent:analyst")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId, status])
}

// Model usage ledger. One row per routed model call (including fallbacks and
// failures) so usage and costs can be tracked per workspace over time.
model ModelCall {
  id               String    @id @default(cuid())
  workspaceId      String
  purpose          String
  provider         String
  model            String
  isFallback       Boolean   @default(false)
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  // Estimated cost in micro-USD (1e-6 USD); 0 when pricing unknown — never guessed
  estCostMicros    Int       @default(0)
  latencyMs        Int       @default(0)
  ok               Boolean   @default(true)
  error            String?
  // US-045: the registered prompt (src/lib/ai/prompts) behind this call, which
  // try it was, and whether its output passed the workflow schema (null when
  // nothing validates it, e.g. chat).
  promptName       String?
  promptVersion    Int?
  attempt          Int       @default(1)
  schemaValid      Boolean?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, promptName, promptVersion])
}

// Command center chat. One persisted conversation per workspace between the
// team and the Banyan agent. Role is a validated string ("user" | "assistant")
// per the schema-wide portability rule. Assistant rows carry the model label
// and fallback flag so the UI can always show what generated a reply — a live
// model or the labeled template fallback. Nothing here is simulated: replies
// are grounded in workspace records at send time.
model ChatMessage {
  id          String    @id @default(cuid())
  workspaceId String
  role        String
  content     String
  modelLabel  String?
  isFallback  Boolean   @default(false)
  latencyMs   Int?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// One analysis of a product's public website (US-021, US-022). The result is
/// a draft the founder reviews and approves (US-023); it never becomes
/// business context on its own.
model ProductAnalysis {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url           String
  // queued | reading | analysing | ready | failed
  status        String    @default("queued")
  // Set when status = failed: invalid_url | blocked_address | unreachable | timeout | http_error | not_html | empty_page
  errorCode     String?
  errorMessage  String?
  // JSON array of the page URLs that were read
  pages         String    @default("[]")
  // JSON of the validated analysis (see src/lib/product/analyze.ts)
  result        String?
  // model | basic (rule-based extraction, labelled as such)
  method        String?
  // JSON array of instruction-like passages found on the pages (US-024)
  flags         String    @default("[]")
  promptVersion String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}

/// A distribution strategy (US-042, US-043). Versioned per workspace; each
/// new version supersedes the previous proposal. `body` is the validated
/// JSON from src/lib/strategy/generate.ts; `facts` snapshots the profile
/// facts it cites so citations still resolve after the profile changes.
model Strategy {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goalId         String?
  version        Int
  // proposed | approved | rejected | superseded
  status         String    @default("proposed")
  body           String
  // model | template
  method         String
  fallbackReason String?
  facts          String    @default("[]")
  objective      String    @default("")
  // The product profile version this was generated from (US-023 → US-042)
  profileVersion Int
  promptName     String?
  promptVersion  Int?
  modelCallId    String?
  createdById    String?
  approvedAt     DateTime?
  approvedById   String?
  rejectedReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, version])
  @@index([workspaceId, status])
}
